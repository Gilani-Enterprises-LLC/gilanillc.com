---
import Logo from './Logo.astro';

const links = [
  { label: 'Services', to: '/services' },
  { label: 'About', to: '/about' },
  { label: 'Insights', to: '/insights' },
  { label: 'Contact', to: '/contact' },
];

const { pathname } = Astro.url;
function isActive(to: string) {
  return pathname === to || pathname === `${to}/`;
}
---

<header
  style={{
    position: 'fixed',
    top: 0,
    left: 0,
    right: 0,
    zIndex: 50,
    transition: 'background 0.2s, box-shadow 0.2s, border-color 0.2s',
    background: 'rgba(248, 247, 244, 0.96)',
    backdropFilter: 'blur(12px)',
    borderBottom: '1px solid var(--border)',
  }}
>
  <div style={{ maxWidth: '1200px', margin: '0 auto', padding: '0 24px' }}>
    <div style={{ display: 'flex', alignItems: 'center', height: '68px', gap: '40px' }}>
      {/* Logo */}
      <a href="/" data-nav-close style={{ textDecoration: 'none', flexShrink: 0 }}>
        <Logo size="sm" />
      </a>

      {/* Desktop nav */}
      <nav style={{ alignItems: 'center', gap: '32px', marginLeft: 'auto' }} class="hidden md:flex">
        {links.map((l) => (
          <a
            href={l.to}
            class="nav-link"
            style={{
              fontFamily: 'Inter, system-ui, sans-serif',
              fontSize: '14px',
              fontWeight: 500,
              letterSpacing: '0.01em',
              color: isActive(l.to) ? 'var(--primary)' : 'var(--foreground)',
              textDecoration: 'none',
              transition: 'color 0.15s',
              opacity: isActive(l.to) ? 1 : 0.82,
            }}
          >
            {l.label}
          </a>
        ))}
      </nav>

      {/* Mobile hamburger */}
      <button
        id="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        style={{
          marginLeft: 'auto',
          flexDirection: 'column',
          gap: '5px',
          padding: '8px',
          background: 'none',
          border: 'none',
          cursor: 'pointer',
        }}
        class="flex md:hidden"
      >
        <span class="nav-bar nav-bar-top"></span>
        <span class="nav-bar nav-bar-mid"></span>
        <span class="nav-bar nav-bar-bottom"></span>
      </button>
    </div>
  </div>
</header>

{/* Mobile menu */}
<div id="nav-mobile-menu" class="nav-mobile-menu">
  {links.map((l) => (
    <a
      href={l.to}
      data-nav-close
      class="nav-mobile-link"
      style={{
        color: isActive(l.to) ? 'var(--primary)' : 'var(--foreground)',
      }}
    >
      {l.label}
    </a>
  ))}
  <a href="/contact" data-nav-close class="nav-mobile-cta">
    Contact Us
  </a>
</div>

<style>
  .nav-link {
    opacity: 0.82;
  }
  .nav-link:hover {
    color: var(--primary);
  }

  .nav-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--foreground);
    transition: transform 0.2s, opacity 0.2s;
  }

  .nav-mobile-menu {
    position: fixed;
    top: 68px;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background: var(--background);
    padding: 32px 24px;
    display: none;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
  }
  .nav-mobile-menu.open {
    display: flex;
  }

  .nav-mobile-link {
    display: block;
    font-family: Inter, system-ui, sans-serif;
    font-size: 22px;
    font-weight: 500;
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .nav-mobile-cta {
    margin-top: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--primary);
    color: var(--primary-foreground);
    font-family: Inter, system-ui, sans-serif;
    font-size: 16px;
    font-weight: 600;
    padding: 14px 32px;
    border-radius: 3px;
    text-decoration: none;
  }

  /* Hamburger -> X animation, driven by the button's aria-expanded state */
  #nav-toggle[aria-expanded='true'] .nav-bar-top {
    transform: translateY(7px) rotate(45deg);
  }
  #nav-toggle[aria-expanded='true'] .nav-bar-mid {
    opacity: 0;
  }
  #nav-toggle[aria-expanded='true'] .nav-bar-bottom {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile-menu');

  if (toggle && menu) {
    const closeMenu = () => {
      menu.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      menu.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    };

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.contains('open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll('[data-nav-close]').forEach((el) => {
      el.addEventListener('click', closeMenu);
    });
  }
</script>
