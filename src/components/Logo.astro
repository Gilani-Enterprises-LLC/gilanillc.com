---
interface Props {
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'dark', size = 'md' } = Astro.props;

const markColor = variant === 'light' ? '#FFFFFF' : '#0C6E58';
const textColor = variant === 'light' ? '#FFFFFF' : '#0F0F0E';
const subColor = variant === 'light' ? 'rgba(255,255,255,0.65)' : '#6B6966';

// Sizes were enlarged so the wordmark reads clearly as the brand and stands
// apart from the 14px navigation links (header/footer use 'md').
const sizes = {
  sm: { mark: 32, g1: '18px', g2: '10px', gap: '10px' },
  md: { mark: 40, g1: '23px', g2: '11px', gap: '12px' },
  lg: { mark: 52, g1: '30px', g2: '13px', gap: '14px' },
};
const s = sizes[size];
---

<div style={{ display: 'flex', alignItems: 'center', gap: s.gap }}>
  {/* Geometric G mark */}
  <svg
    width={s.mark}
    height={s.mark}
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    {/* Outer arc — most of a circle, opening at the upper-right (a "G").
        The original path used sweep-flag 1, which placed the arc's centre
        outside the viewBox so only clipped fragments rendered. */}
    <path
      d="M 29.9 10.1 A 14 14 0 1 0 34 20"
      stroke={markColor}
      stroke-width="2.8"
      stroke-linecap="round"
      fill="none"
    />
    {/* Horizontal crossbar from the arc's end toward the center */}
    <path
      d="M 21 20 L 34 20"
      stroke={markColor}
      stroke-width="2.8"
      stroke-linecap="round"
    />
    {/* Small inner node at center */}
    <circle cx="20" cy="20" r="2" fill={markColor} />
  </svg>

  {/* Wordmark (decorative; links wrapping the logo provide an sr-only name) */}
  <div aria-hidden="true" style={{ lineHeight: 1.1 }}>
    <div
      style={{
        fontFamily: 'var(--font-sans)',
        fontWeight: 700,
        fontSize: s.g1,
        letterSpacing: '-0.02em',
        color: textColor,
      }}
    >
      Gilani
    </div>
    <div
      style={{
        fontFamily: 'var(--font-sans)',
        fontWeight: 500,
        fontSize: s.g2,
        letterSpacing: '0.16em',
        marginTop: '2px',
        textTransform: 'uppercase',
        color: subColor,
      }}
    >
      Enterprises
    </div>
  </div>
</div>
